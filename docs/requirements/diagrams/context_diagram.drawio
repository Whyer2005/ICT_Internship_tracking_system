<mxfile host="app.diagrams.net"><diagram id="context_diagram" name="Context Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;0&lt;/b&gt;&lt;br&gt;&lt;b&gt;ระบบติดตามการฝึกงาน&lt;br&gt;คณะ ICT&lt;/b&gt;&lt;br&gt;(ICT Internship&lt;br&gt;Tracking System)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="410" width="300" height="300" as="geometry"/></mxCell><mxCell id="c3" value="นิสิต&lt;br&gt;(Student)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="205" width="220" height="70" as="geometry"/></mxCell><mxCell id="c4" value="ข้อมูลส่วนตัว, CV, ชั่วโมงอบรม (+หน่วยงานผู้จัด/ลิงก์),&lt;br&gt;Checklist, ใบสมัครสหกิจ, แบบตอบรับ, ทางเลือกรอบที่ 2" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c3" target="c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="461" y="472"/></Array></mxGeometry></mxCell><mxCell id="c5" value="สถานะความคืบหน้า, คอมเมนต์ CV, ผลการตรวจ,&lt;br&gt;ผลสหกิจ, เอกสารที่ดาวน์โหลดได้" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="529" y="328"/></Array></mxGeometry></mxCell><mxCell id="c6" value="อาจารย์ที่ปรึกษา&lt;br&gt;(Advisor)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="825" width="220" height="70" as="geometry"/></mxCell><mxCell id="c7" value="คอมเมนต์ CV,&lt;br&gt;ผลอนุมัติ Checklist, ผลตรวจแบบตอบรับ" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c6" target="c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="528" y="783"/></Array></mxGeometry></mxCell><mxCell id="c8" value="รายชื่อนิสิตในความดูแล,&lt;br&gt;รายการรอตรวจ, สถานะสหกิจ" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="462" y="637"/></Array></mxGeometry></mxCell><mxCell id="c9" value="อาจารย์ประจำวิชา&lt;br&gt;(Course Admin)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="55" width="220" height="70" as="geometry"/></mxCell><mxCell id="c10" value="รายชื่อนิสิต (Excel), ที่ปรึกษา,&lt;br&gt;ผลอนุมัติชั่วโมงอบรม, คอมเมนต์ CV,&lt;br&gt;เปิดให้แก้ชื่อ-สกุล, สถานะตกค้าง" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c9" target="c2"><mxGeometry x="0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="325"/></Array></mxGeometry></mxCell><mxCell id="c11" value="Dashboard ภาพรวม, รายงาน" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c2" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="325"/></Array></mxGeometry></mxCell><mxCell id="c12" value="เจ้าหน้าที่ฝ่ายฝึกงาน&lt;br&gt;(Staff)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1390" y="265" width="220" height="70" as="geometry"/></mxCell><mxCell id="c13" value="ตั้งค่ารุ่น/รอบ, ข้อมูลบริษัท, แบบฟอร์มรายสาขา,&lt;br&gt;ประกาศ/ผลสหกิจ, ยืนยันแบบตอบรับ, คำสั่งออกหนังสือ" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c12" target="c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1136" y="355"/></Array></mxGeometry></mxCell><mxCell id="c14" value="คิวออกหนังสือ, ใบสมัครสหกิจ (PDF รวม),&lt;br&gt;หนังสือราชการ (PDF), ไฟล์ Co-op 01" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c2" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1194" y="505"/></Array></mxGeometry></mxCell><mxCell id="c15" value="ผู้บริหาร (PM) (*)&lt;br&gt;(Executive)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="1005" width="220" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Dashboard ภาพรวมทุกสาขา (*)" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c2" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="800"/></Array></mxGeometry></mxCell><mxCell id="c17" value="Microsoft Entra ID&lt;br&gt;(บัญชี @up.ac.th)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1390" y="825" width="220" height="70" as="geometry"/></mxCell><mxCell id="c18" value="ข้อมูลผู้ใช้ (ชื่อ, อีเมล)" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c17" target="c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1198" y="637"/></Array></mxGeometry></mxCell><mxCell id="c19" value="คำขอยืนยันตัวตน" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c2" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1132" y="783"/></Array></mxGeometry></mxCell><mxCell id="c20" value="ระบบ Co-op กลาง (*)&lt;br&gt;(University Co-op System)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1390" y="565" width="220" height="70" as="geometry"/></mxCell><mxCell id="c21" value="ข้อมูล Co-op 01&lt;br&gt;(ผ่านไฟล์ Export)" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="c2" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="660"/></Array></mxGeometry></mxCell><mxCell id="c22" value="Context Diagram (DFD Level 0) — ระบบติดตามการฝึกงาน คณะ ICT" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="900" height="30" as="geometry"/></mxCell><mxCell id="c23" value="สี่เหลี่ยมฟ้า = ผู้ใช้ภายนอก · สี่เหลี่ยมเทา = ระบบภายนอก · ลูกศร = การไหลของข้อมูล · (*) = ต้องเคาะในที่ประชุม · สถานประกอบการไม่ได้ใช้ระบบโดยตรง (รับ/ส่งเอกสารผ่านนิสิตและเจ้าหน้าที่) · ปรับปรุง 26 พ.ย. 2569" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1500" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>