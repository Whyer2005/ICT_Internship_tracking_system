<mxfile host="app.diagrams.net"><diagram id="method" name="Research Methodology"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="เริ่มต้น" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="130.0" y="10" width="150" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1.&lt;/b&gt; ศึกษาระบบเดิมและกระบวนการ&lt;br&gt;ฝึกงานของคณะ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="35.0" y="80" width="340" height="64" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2.&lt;/b&gt; เก็บรวบรวมความต้องการ&lt;br&gt;(สัมภาษณ์เจ้าหน้าที่ · ประชุมอาจารย์)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="35.0" y="174" width="340" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;3.&lt;/b&gt; วิเคราะห์และออกแบบ&lt;br&gt;(Business Rules · Use Case · DFD · ER)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="35.0" y="268" width="340" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;4.&lt;/b&gt; พัฒนาหน้าจอต้นแบบ&lt;br&gt;(Front-end Demo)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="35.0" y="362" width="340" height="64" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;5.&lt;/b&gt; ประชุม Demo กับ&lt;br&gt;ตัวแทนอาจารย์ 8 สาขา" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="35.0" y="456" width="340" height="64" as="geometry"/></mxCell><mxCell id="c8" value="Requirement&lt;br&gt;ยืนยันแล้ว?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90.0" y="550" width="230" height="96" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;6.&lt;/b&gt; พัฒนาระบบแบบวนรอบ&lt;br&gt;(Sprint 1–2 สัปดาห์)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440.0" y="80" width="340" height="64" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;7.&lt;/b&gt; ทดสอบระบบ&lt;br&gt;(Unit · Functional · Load Test)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440.0" y="174" width="340" height="64" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;8.&lt;/b&gt; ทดสอบกับผู้ใช้จริง (UAT)&lt;br&gt;+ แบบประเมินความพึงพอใจ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440.0" y="268" width="340" height="64" as="geometry"/></mxCell><mxCell id="c12" value="ผ่านเกณฑ์?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="495.0" y="362" width="230" height="96" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;9.&lt;/b&gt; ติดตั้งระบบ จัดทำคู่มือ&lt;br&gt;สรุปผลและรายงาน" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440.0" y="488" width="340" height="64" as="geometry"/></mxCell><mxCell id="c14" value="สิ้นสุด" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="535.0" y="582" width="150" height="40" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=block;