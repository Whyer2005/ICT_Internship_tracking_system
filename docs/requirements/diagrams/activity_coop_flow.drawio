<mxfile host="app.diagrams.net"><diagram id="activity_coop_flow" name="Activity Diagram — สหกิจศึกษา"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1530" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Activity Diagram — สหกิจศึกษา: ประกาศ → สมัคร → ผลคัดเลือก → เอกสารหลังผ่าน" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1000" height="30" as="geometry"/></mxCell><mxCell id="n3" value="นิสิต (Student)" style="swimlane;startSize=36;html=1;fontStyle=1;fontSize=13;fontColor=#1f6fd1;strokeColor=#999999;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="340" height="1400" as="geometry"/></mxCell><mxCell id="n4" value="เจ้าหน้าที่ฝ่ายฝึกงาน (Staff)" style="swimlane;startSize=36;html=1;fontStyle=1;fontSize=13;fontColor=#d97706;strokeColor=#999999;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="340" height="1400" as="geometry"/></mxCell><mxCell id="n5" value="ระบบ (System)" style="swimlane;startSize=36;html=1;fontStyle=1;fontSize=13;fontColor=#666666;strokeColor=#999999;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="340" height="1400" as="geometry"/></mxCell><mxCell id="n6" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="535" y="110" width="30" height="30" as="geometry"/></mxCell><mxCell id="n7" value="เพิ่มประกาศ / นำเข้าจาก Excel&lt;br&gt;(UC-19)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="240" height="56" as="geometry"/></mxCell><mxCell id="n8" value="ดูประกาศ เลือกบริษัท + ตำแหน่ง&lt;br&gt;(UC-19)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="270" width="240" height="56" as="geometry"/></mxCell><mxCell id="n9" value="ผ่านเงื่อนไขสมัคร?&lt;br&gt;CV + ชั่วโมงครบ + รอบเปิด&lt;br&gt;+ ยังไม่ยื่นฝึกงาน" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="790" y="340" width="200" height="110" as="geometry"/></mxCell><mxCell id="n10" value="แนบ Resume (จาก CV / อัปโหลด)&lt;br&gt;+ Transcript (+ Portfolio) → ยืนยัน (UC-20)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="490" width="240" height="56" as="geometry"/></mxCell><mxCell id="n11" value="ผูกรอบออกฝึก · ล็อกเมนูสถานประกอบการ&lt;br&gt;สถานะ: ส่งใบสมัครแล้ว (SUBMITTED)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="770" y="590" width="240" height="56" as="geometry"/></mxCell><mxCell id="n12" value="ยกเลิกเอง?&lt;br&gt;(ก่อนส่งเอกสาร)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="135" y="690" width="150" height="80" as="geometry"/></mxCell><mxCell id="n13" value="ดาวน์โหลด PDF รวม → ส่งเอกสารให้บริษัท&lt;br&gt;(SENT_TO_COMPANY)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="800" width="240" height="56" as="geometry"/></mxCell><mxCell id="n14" value="ผลจากบริษัท?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="475" y="900" width="150" height="80" as="geometry"/></mxCell><mxCell id="n15" value="เก็บใบสมัครเข้าประวัติ&lt;br&gt;ปลดล็อกเมนูสถานประกอบการ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="770" y="900" width="240" height="56" as="geometry"/></mxCell><mxCell id="n16" value="เจ้าหน้าที่ยกเลิกแทนได้ทุกขั้น (รวมหลังผ่าน)&lt;br&gt;ต้องใส่เหตุผล → เข้าประวัติเช่นกัน" style="text;html=1;fontSize=11;fontColor=#555555;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="770" y="965" width="280" height="40" as="geometry"/></mxCell><mxCell id="n17" value="บันทึกผ่านการคัดเลือก&lt;br&gt;(ACCEPTED)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="1010" width="240" height="56" as="geometry"/></mxCell><mxCell id="n18" value="เอกสารหลังผ่าน (แนบไฟล์ได้): ขอความอนุเคราะห์&lt;br&gt;→ แบบตอบรับ → หนังสือส่งตัว (UC-21)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="1110" width="260" height="56" as="geometry"/></mxCell><mxCell id="n19" value="ดูขั้นเอกสาร / เปิดไฟล์&lt;br&gt;ในแท็บสหกิจศึกษา" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="1210" width="240" height="56" as="geometry"/></mxCell><mxCell id="n20" value="Export Co-op 01&lt;br&gt;(ฝึกงาน + สหกิจ / เฉพาะสหกิจ)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="1310" width="240" height="56" as="geometry"/></mxCell><mxCell id="n21" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="533" y="1410" width="34" height="34" as="geometry"/></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" a