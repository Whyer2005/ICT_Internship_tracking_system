<mxfile host="app.diagrams.net"><diagram id="use_case_diagram" name="Use Case Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="ระบบติดตามการฝึกงาน คณะ ICT (ICT Internship Tracking System)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="1200" height="988" as="geometry"/></mxCell><mxCell id="c3" value="ทั่วไป (General)" style="rounded=1;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=11;html=1;whiteSpace=wrap;arcSize=6;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="1160" height="120" as="geometry"/></mxCell><mxCell id="c4" value="เข้าสู่ระบบ&lt;br&gt;(Login)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="795" y="130" width="210" height="70" as="geometry"/></mxCell><mxCell id="c5" value="1. เตรียมความพร้อม (Preparation)" style="rounded=1;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=11;html=1;whiteSpace=wrap;arcSize=6;" vertex="1" parent="1"><mxGeometry x="320" y="224" width="1160" height="120" as="geometry"/></mxCell><mxCell id="c6" value="UC-01 อัปโหลด/แก้ไข CV&lt;br&gt;(Upload CV)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="264" width="210" height="70" as="geometry"/></mxCell><mxCell id="c7" value="UC-03 บันทึกชั่วโมงอบรม&lt;br&gt;(Record Training Hours)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="568" y="264" width="210" height="70" as="geometry"/></mxCell><mxCell id="c8" value="UC-02 คอมเมนต์ CV (ไม่ต้องอนุมัติ)&lt;br&gt;(Comment on CV)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="795" y="264" width="210" height="70" as="geometry"/></mxCell><mxCell id="c9" value="UC-04 อนุมัติชั่วโมงอบรม&lt;br&gt;(Approve Training Hours)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1022" y="264" width="210" height="70" as="geometry"/></mxCell><mxCell id="c10" value="UC-16 ลงทะเบียนอบรม/สแกน QR (*)&lt;br&gt;(Training Check-in) ⏸" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeColor=#b85450;fillColor=#f8cecc;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1250" y="264" width="210" height="70" as="geometry"/></mxCell><mxCell id="c11" value="2. ตั้งค่ารุ่น/รอบ และผู้ใช้ (Setup)" style="rounded=1;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=11;html=1;whiteSpace=wrap;arcSize=6;" vertex="1" parent="1"><mxGeometry x="320" y="358" width="1160" height="120" as="geometry"/></mxCell><mxCell id="c12" value="UC-15 นำเข้ารายชื่อนิสิต/กำหนดที่ปรึกษา&lt;br&gt;(Import Students)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="398" width="210" height="70" as="geometry"/></mxCell><mxCell id="c13" value="UC-05 สร้างรุ่นและเปิด/ปิดรอบออกฝึก&lt;br&gt;(Manage Cohorts &amp;amp; Windows)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="568" y="398" width="210" height="70" as="geometry"/></mxCell><mxCell id="c14" value="เปิดต่อพิเศษ&lt;br&gt;(Extend Window)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="795" y="398" width="210" height="70" as="geometry"/></mxCell><mxCell id="c15" value="UC-17 นำเข้าข้อมูลบริษัท (*)&lt;br&gt;(Import Companies)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeColor=#b85450;fillColor=#f8cecc;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1250" y="398" width="210" height="70" as="geometry"/></mxCell><mxCell id="c16" value="3. Checklist สถานประกอบการ (Checklist)" style="rounded=1;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=11;html=1;whiteSpace=wrap;arcSize=6;" vertex="1" parent="1"><mxGeometry x="320" y="492" width="1160" height="120" as="geometry"/></mxCell><mxCell id="c17" value="UC-06 ยื่น Checklist สถานประกอบการ&lt;br&gt;(Submit Checklist)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="532" width="210" height="70" as="geometry"/></mxCell><mxCell id="c18" value="ผูกรอบออกฝึกอัตโนมัติ&lt;br&gt;(Auto-assign Window)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="795" y="532" width="210" height="70" as="geometry"/></mxCell><mxCell id="c19" value="UC-07 อนุมัติ/ตีกลับ Checklist&lt;br&gt;(Review Checklist)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1250" y="532" width="210" height="70" as="geometry"/></mxCell><mxCell id="c20" value="4. เอกสารราชการ (Official Documents)" style="rounded=1;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=11;html=1;whiteSpace=wrap;arcSize=6;" vertex="1" parent="1"><mxGeometry x="320" y="626" width="1160" height="120" as="geometry"/></mxCell><mxCell id="c21" value="UC-09 อัปโหลดแบบตอบรับ&lt;br&gt;(Upload Acceptance Form)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="666" width="210" height="70" as="geometry"/></mxCell><mxCell id="c22" value="UC-10 ตรวจ/ยืนยันแบบตอบรับ&lt;br&gt;(Verify Acceptance Form)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="568" y="666" width="210" height="70" as="geometry"/></mxCell><mxCell id="c23" value="วิเคราะห์แบบตอบรับอัตโนมัติ&lt;br&gt;(OMR)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="795" y="666" width="210" height="70" as="geometry"/></mxCell><mxCell id="c24" value="UC-08 ออกหนังสือขอความอนุเคราะห์&lt;br&gt;(Issue Request Letter)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1022" y="666" width="210" height="70" as="geometry"/></mxCell><mxCell id="c25" value="UC-11 ออกหนังสือส่งตัว&lt;br&gt;(Issue Dispatch Letter)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1250" y="666" width="210" height="70" as="geometry"/></mxCell><mxCell id="c26" value="5. รอบที่ 2 / ติดตาม / ส่งต่อข้อมูล (Round 2, Monitoring, Export)" style="rounded=1;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=11;html=1;whiteSpace=wrap;arcSize=6;" vertex="1" parent="1"><mxGeometry x="320" y="760" width="1160" height="120" as="geometry"/></mxCell><mxCell id="c27" value="UC-12 ฝึกงานรอบที่ 2 / ตกค้าง&lt;br&gt;(Round 2 / Retest)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="800" width="210" height="70" as="geometry"/></mxCell><mxCell id="c28" value="UC-13 ติดตามผ่าน Dashboard (*