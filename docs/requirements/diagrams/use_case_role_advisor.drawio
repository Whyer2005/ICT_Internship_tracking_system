<mxfile host="app.diagrams.net"><diagram id="use_case_role_advisor.drawio" name="Use Case — อาจารย์ที่ปรึกษา"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="ระบบติดตามการฝึกงาน คณะ ICT (ICT Internship Tracking System)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="760" height="644" as="geometry"/></mxCell><mxCell id="c2" value="Use Case Diagram — อาจารย์ที่ปรึกษา (Advisor)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="5 Use Case · ยังต้องเคาะ 1 รายการ (กรอบแดง) · ชั่วโมงอบรมดูได้อย่างเดียว (อาจารย์ประจำวิชาเป็นผู้อนุมัติ)" style="text;html=1;fontSize=13;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1000" height="22" as="geometry"/></mxCell><mxCell id="c4" value="1. เตรียมความพร้อม (Preparation)" style="rounded=1;arcSize=4;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="720" height="108" as="geometry"/></mxCell><mxCell id="c5" value="UC-02 คอมเมนต์ CV (ไม่ต้องอนุมัติ)&lt;br&gt;(Comment on CV)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="162" width="330" height="58" as="geometry"/></mxCell><mxCell id="c6" value="3. Checklist สถานประกอบการ (Checklist)" style="rounded=1;arcSize=4;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="720" height="108" as="geometry"/></mxCell><mxCell id="c7" value="UC-07 อนุมัติ / ตีกลับ Checklist&lt;br&gt;(Review Checklist)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="282" width="330" height="58" as="geometry"/></mxCell><mxCell id="c8" value="4. เอกสารราชการ (Official Documents)" style="rounded=1;arcSize=4;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="720" height="108" as="geometry"/></mxCell><mxCell id="c9" value="UC-10 ตรวจ / ยืนยันแบบตอบรับ&lt;br&gt;(Verify Acceptance Form)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="402" width="330" height="58" as="geometry"/></mxCell><mxCell id="c10" value="5. รอบที่ 2 / ติดตาม / ส่งต่อข้อมูล (Round 2, Monitoring, Export)" style="rounded=1;arcSize=4;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="490" width="720" height="108" as="geometry"/></mxCell><mxCell id="c11" value="UC-13 ติดตามผ่าน Dashboard (*)&lt;br&gt;(Monitor Dashboard)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="522" width="330" height="58" as="geometry"/></mxCell><mxCell id="c12" value="6. สหกิจศึกษา (Co-operative Education)" style="rounded=1;arcSize=4;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="610" width="720" height="108" as="geometry"/></mxCell><mxCell id="c13" value="UC-21 ดูสถานะสหกิจของนิสิต (อ่านอย่างเดียว)&lt;br&gt;(View Co-op Status)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="642" width="330" height="58" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#2e8b57;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="367" width="44" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;อาจารย์ที่ปรึกษา&lt;/b&gt;&lt;br&gt;(Advisor)" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#2e8b57;" vertex="1" parent="1"><mxGeometry x="10" y="382" width="140" height="60" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=none;html=1;strokeColor=#2e8b57;strokeWidth=1.5;" edge="1" parent="1" source="c14" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="191"/></Array></mxGeometry></mxCell><mxCell id="c17" value="" style="endArrow=none;html=1;strokeColor=#2e8b57;strokeWidth=1.5;" edge="1" parent="1" source="c14" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="311"/></Array></mxGeometry></mxCell><mxCell id="c18" value="" style="endArrow=none;html=1;strokeColor=#2e8b57;strokeWidth=1.5;" edge="1" parent="1" source="c14" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="431"/></Array></mxGeometry></mxCell><mxCell id="c19" value="" style="endArrow=none;html=1;strokeColor=#2e8b57;strokeWidth=1.5;" edge="1" parent="1" source="c14" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="551"/></Array></mxGeometry></mxCell><mxCell id="c20" value="" style="endArrow=none;html=1;strokeColor=#2e8b57;strokeWidth=1.5;" edge="1" parent="1" source="c14" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="671"/></Array></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;ประเด็นที่ต้องเคาะ (บทบาทนี้)&lt;/b&gt;&lt;br&gt;• OI-06 ช่องทางแจ้งเตือนเมื่อมีงานรอตรวจ&lt;br&gt;• OI-14 นิสิตตกค้างเปลี่ยนอาจารย์ที่ปรึกษาหรือไม่&lt;br&gt;• OI-04 อาจารย์นิเทศก์ยังต้องมีในระบบหรือไม่" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fff5f5;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1090" y="90" width="350" height="116" as="geometry"/></mxCell><mxCell id="c22" value="วงรีขาว = ทำได้แล้ว · กรอบแดง (*) = รอเคาะ · กรอบแดงเส้นประ = ร่าง / ยังไม่พัฒนา · วงรีเทา = Use Case ย่อย&lt;br&gt;ทุก Use Case ต้องเข้าสู่ระบบด้วยบัญชี @up.ac.th ก่อน · รายละเอียดใน 03_USE_CASES.md · ปรับปรุง 26 พ.ย. 2569" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="280" y="748" width="1110" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>