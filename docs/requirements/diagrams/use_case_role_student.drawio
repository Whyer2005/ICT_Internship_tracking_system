<mxfile host="app.diagrams.net"><diagram id="use_case_role_student.drawio" name="Use Case — นิสิต"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="ระบบติดตามการฝึกงาน คณะ ICT (ICT Internship Tracking System)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="760" height="746" as="geometry"/></mxCell><mxCell id="c2" value="Use Case Diagram — นิสิต (Student)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="7 Use Case · ยังต้องเคาะ 2 รายการ (กรอบแดง)" style="text;html=1;fontSize=13;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="900" height="22" as="geometry"/></mxCell><mxCell id="c4" value="1. เตรียมความพร้อม (Preparation)" style="rounded=1;arcSize=4;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="720" height="256" as="geometry"/></mxCell><mxCell id="c5" value="UC-01 อัปโหลด / แก้ไข CV&lt;br&gt;(Upload CV)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="162.0" width="330" height="58" as="geometry"/></mxCell><mxCell id="c6" value="UC-03 บันทึกชั่วโมงอบรม&lt;br&gt;(Record Training Hours)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="236.0" width="330" height="58" as="geometry"/></mxCell><mxCell id="c7" value="UC-16 ลงทะเบียนอบรม / สแกน QR (*) ⏸&lt;br&gt;(Trainin