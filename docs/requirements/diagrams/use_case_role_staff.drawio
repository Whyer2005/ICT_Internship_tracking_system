<mxfile host="app.diagrams.net"><diagram id="use_case_role_staff.drawio" name="Use Case — เจ้าหน้าที่ฝ่ายฝึกงาน"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="ระบบติดตามการฝึกงาน คณะ ICT (ICT Internship Tracking System)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=none;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="760" height="1430" as="geometry"/></mxCell><mxCell id="c2" value="Use Case Diagram — เจ้าหน้าที่ฝ่ายฝึกงาน (Staff)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="15 Use Case · ยังต้องเคาะ 5 รายการ (กรอบแดง) · งานเอกสาร/ตั้งค่าหนังสือ/แบบฟอร์ม/ประกาศสหกิจ = เจ้าหน้าที่เท่านั้น (บังคับที่ API)" style="text;html=1;fontSize=13;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1000" height="22" as="geometry"/></mxCell><mxCell id="c4" value="1. เตรียมความพร้อม (Preparation)" style="rounded=1;arcSize=4;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="720" height="108" as="geometry"/></mxCell><mxCell id="c5" value="UC-16 ลงทะเบียนอบรม / สแกน QR (*) ⏸&lt;br&gt;(Training Check-in)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="162" width="330" height="58" as="geometry"/></mxCell><mxCell id="c6" value="2. ตั้งค่ารุ่น/รอบ และข้อมูลตั้งต้น (Setup)" style="rounded=1;arcSize=4;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="720" height="256" as="geometry"/></mxCell><mxCell id="c7" value="UC-15 นำเข้ารายชื่อนิสิต / กำหนดที่ปรึกษา&lt;br&gt;(Import Students)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="282" width="330" height="58" as="geometry"/></mxCell><mxCell id="c8" value="UC-05 สร้างรุ่นและเปิด/ปิดรอบออกฝึก&lt;br&gt;(Manage Cohorts &amp; Windows)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="356" width="330" height="58" as="geometry"/></mxCell><mxCell id="c9" value="เปิดต่อพิเศษ&lt;br&gt;(Extend Window)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="750" y="356" width="260" height="58" as="geometry"/></mxCell><mxCell id="c10" value="UC-17 นำเข้าข้อมูลบริษัท (*)&lt;br&gt;(Import Companies)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="430" width="330" height="58" as="geometry"/></mxCell><mxCell id="c11" value="3. Checklist สถานประกอบการ (Checklist)" style="rounded=1;arcSize=4;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="518" width="720" height="108" as="geometry"/></mxCell><mxCell id="c12" value="UC-22 แบบฟอร์มการเลือกสถานประกอบการแยกตามสาขา&lt;br&gt;(Manage Checklist Forms)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="550" width="330" height="58" as="geometry"/></mxCell><mxCell id="c13" value="4. เอกสารราชการ (Official Documents)" style="rounded=1;arcSize=4;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="638" width="720" height="256" as="geometry"/></mxCell><mxCell id="c14" value="UC-08 ออกหนังสือขอความอนุเคราะห์&lt;br&gt;(Issue Request Letter)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="670" width="330" height="58" as="geometry"/></mxCell><mxCell id="c15" value="UC-10 ตรวจ / ยืนยันแบบตอบรับ&lt;br&gt;(Verify Acceptance Form)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="744" width="330" height="58" as="geometry"/></mxCell><mxCell id="c16" value="วิเคราะห์แบบตอบรับอัตโนมัติ&lt;br&gt;(OMR)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="750" y="744" width="260" height="58" as="geometry"/></mxCell><mxCell id="c17" value="UC-11 ออกหนังสือส่งตัว&lt;br&gt;(Issue Dispatch Letter)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="818" width="330" height="58" as="geometry"/></mxCell><mxCell id="c18" value="5. รอบที่ 2 / ติดตาม / ส่งต่อข้อมูล (Round 2, Monitoring, Export)" style="rounded=1;arcSize=4;dashed=1;fillColor=#fafafa;strokeColor=#aaaaaa;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="906" width="720" height="330" as="geometry"/></mxCell><mxCell id="c19" value="UC-12 ฝึกงานรอบที่ 2 / ตกค้าง&lt;br&gt;(Round 2 / Retest)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="938" width="330" height="58" as="geometry"/></mxCell><mxCell id="c20" value="UC-18 เรียกตัวกลับ / ยุติการฝึก (*)&lt;br&gt;(Recall / Terminate)" style="