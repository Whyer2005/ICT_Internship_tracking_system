generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// 1. USER & ROLE
//    User = ตารางกลางไว้ login เพียงอย่างเดียว (username/email/password)
//    แล้วแยกโปรไฟล์จริงไปตาม role คือ Student หรือ Staff (1:1)
// =====================================================================

enum Role {
  STUDENT
  ADVISOR            // อาจารย์ที่ปรึกษา
  STAFF              // เจ้าหน้าที่
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String?  // เก็บเป็น hash เท่านั้น (ของเดิมยังไม่มี field นี้ แต่ต้องมีไว้ login)
                      // ทำเป็น optional เพราะ user ที่ login ผ่าน Microsoft OAuth ไม่มี password ในระบบเราเอง
  role      Role
  createdAt DateTime @default(now())

  student Student?
  staff   Staff?
}

// =====================================================================
// 2. STUDENT PROFILE
// =====================================================================

// สถานะรวมของนิสิต ที่โชว์บนหัวการ์ด "ข้อมูลและสถานะของนิสิต"
enum InternshipStage {
  PENDING_DOCUMENTS // รอยื่นเอกสาร
  PENDING_APPROVAL  // รอการอนุมัติ
  READY             // พร้อมฝึกงาน
}

model Student {
  id              Int             @id @default(autoincrement())
  userId          Int             @unique
  user            User            @relation(fields: [userId], references: [id])

  studentCode     String          @unique // รหัสนิสิต เช่น 676767 / 670xxxxx
  nameTh          String          // ชื่อ-สกุล (ไทย)
  nameEn          String          // Name & Surname (English)
  nickname        String?         // ชื่อเล่น
  faculty         String          @default("คณะเทคโนโลยีสารสนเทศและการสื่อสาร") // คณะ
  curriculum      String?         // หลักสูตร / สาขาวิชา
  academicYear    String?         // ปีการศึกษา เช่น "2567" หรือ "2568"
  semester        String?         @default("2") // ภาคเรียนที่ออกฝึกงาน เช่น "1", "2", "SUMMER"
  studentStatus   String?         @default("กำลังศึกษา") // สถานะนิสิต เช่น กำลังศึกษา, พักการเรียน
  internshipType  String?         @default("NEW")       // ประเภทการฝึก เช่น NEW (ฝึกรอบแรก), RETEST (ฝึกรอบใหม่/ตกค้าง)
  year            Int             // ชั้นปีที่
  major           String?         // สาขาวิชา เช่น "สาขาวิชาวิศวกรรมซอฟต์แวร์"
  gpa             Float?          // เกรดเฉลี่ย
  phone           String?
  lineId          String?
  facebook        String?
  otherInfo       String?         // ข้อมูลเพิ่มเติม (ความสามารถพิเศษ โรคประจำตัว ข้อจำกัด ฯลฯ) — หน้า status-all การ์ด "อื่นๆ"
  profileImageUrl String?

  advisorId       Int?
  advisor         Staff?          @relation("AdvisorToStudents", fields: [advisorId], references: [id])

  supervisorId    Int?            // อาจารย์นิเทศก์
  supervisor      Staff?          @relation("SupervisorToStudents", fields: [supervisorId], references: [id])

  stage           InternshipStage @default(PENDING_DOCUMENTS)
  isDropped       Boolean         @default(false)
  dropReason      String?
  droppedAt       DateTime?

  cv              StudentCV?
  trainingRecords TrainingRecord[]
  companies       Company[]
  placement       InternshipPlacement?
  coopApplications CoopApplication[] // ใบสมัครสหกิจศึกษา

  // รอบออกฝึกที่นิสิตเลือก (เช่น 2/2568, 3/2569 Summer, 1/2570)
  internshipWindowId Int?
  internshipWindow   InternshipWindow? @relation(fields: [internshipWindowId], references: [id], onDelete: SetNull)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// =====================================================================
// 2.1 รุ่น (Cohort) และรอบออกฝึก (Internship Window) รายสาขา
//     รุ่น = รหัสนิสิต 2 ตัวแรก (เช่น "67") / แต่ละสาขาในรุ่นมีได้หลายรอบออกฝึก (ปกติ + Summer)
// =====================================================================

enum CohortStatus {
  ACTIVE   // กำลังใช้งาน
  ARCHIVED // ปิดรุ่น / เก็บเข้าประวัติ (อ่านอย่างเดียว)
}

enum InternshipTermType {
  REGULAR // ภาคเรียนปกติ
  SUMMER  // ภาคฤดูร้อน
}

model InternshipCohort {
  id         Int                @id @default(autoincrement())
  code       String             @unique // รหัสรุ่น เช่น "67"
  status     CohortStatus       @default(ACTIVE)
  note       String?
  archivedAt DateTime?
  archivedBy String?
  archivedAcademicYear String? // ปีการศึกษาที่จบกระบวนการ (พ.ศ. เช่น "2569") เลือกตอนปิดรุ่น ใช้ออกรายงานระดับมหาวิทยาลัย
  archiveRetestStudentIds Int[] @default([]) // นิสิตที่ระบบเปลี่ยนจาก NEW เป็นตกค้าง (RETEST) ตอนปิดรุ่น — เปิดรุ่นกลับจะคืนเป็น NEW ให้

  windows    InternshipWindow[]

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model InternshipWindow {
  id            Int                @id @default(autoincrement())
  cohortId      Int
  cohort        InternshipCohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  majorCode     String             // รหัสสาขา เช่น "SE" (ดู src/utils/majors.ts)
  term          String             // รอบเทอมที่ออกฝึก เช่น "2/2568", "3/2569"
  termType      InternshipTermType @default(REGULAR)
  isOptional    Boolean            @default(false) // รอบไม่บังคับ (เช่น Summer)

  openDate      DateTime?          @db.Date // ช่วงเปิดยื่นบริษัท
  closeDate     DateTime?          @db.Date
  internStartDate DateTime?        @db.Date // วันเริ่มฝึก (ตามแผนของรอบ ใช้ระบุช่วงฝึกในหนังสือ + โปรไฟล์นิสิต)
  internEndDate DateTime?          @db.Date // วันสิ้นสุดการฝึก (ใช้ปลดล็อก CV/ชั่วโมงอบรมอัตโนมัติ)

  isUnlocked    Boolean            @default(false) // พี่จอมกดปลดล็อก
  extendedOpen  Boolean            @default(false) // เปิดต่อพิเศษหลังพ้นวันปิด (Override Auto-lock)
  isCompleted   Boolean            @default(false) // พี่จอมกด "จบรอบ" เอง
  completedAt   DateTime?
  note          String?
  sortOrder     Int                @default(0)

  students      Student[]
  coopApplications CoopApplication[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([cohortId, majorCode, term])
  @@index([majorCode])
}

// ---------------------------------------------------------------------
// สหกิจศึกษา: ประกาศรับนิสิตที่พี่จอม (Staff) เพิ่มเอง / นำเข้าจาก Excel
// 1 ประกาศ = 1 บริษัท มีได้หลายตำแหน่ง · รอบเทอม/ช่วงฝึก/วันปิดยื่น ใช้ตามรอบออกฝึกของสาขานิสิต (InternshipWindow)
// ข้อมูลผู้ติดต่อ HR เห็นเฉพาะเจ้าหน้าที่ — API ฝั่งนิสิตไม่ส่งออกไป
// ---------------------------------------------------------------------
model CoopPosting {
  id              Int       @id @default(autoincrement())
  companyName     String // ชื่อบริษัท (ไทย)
  companyNameEn   String?
  masterCompanyId String? // อ้างอิงฐานข้อมูลบริษัทกลาง (ถ้าเลือกจากรายการ)
  description     String? // รายละเอียดบริษัท
  qualifications  String? // คุณสมบัติเพิ่มเติม
  benefits        String? // สวัสดิการ / เบี้ยเลี้ยง / ที่พัก
  address         String? // ที่อยู่ (ไม่เก็บพิกัด)
  province        String? // ชื่อจังหวัดมาตรฐาน (src/utils/thaiProvinces.ts) หรือ "ต่างประเทศ"
  website         String?
  isClosed        Boolean   @default(false) // เจ้าหน้าที่กดปิดรับก่อนกำหนด
  hrContactName   String? // เห็นเฉพาะเจ้าหน้าที่
  hrPhone         String?
  hrEmail         String?
  createdBy       String?

  positions    CoopPosition[]
  applications CoopApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoopPosition {
  id           Int               @id @default(autoincrement())
  postingId    Int
  posting      CoopPosting       @relation(fields: [postingId], references: [id], onDelete: Cascade)
  title        String // ชื่อตำแหน่ง
  seats        Int? // จำนวนที่รับนิสิตคณะนี้ (ไม่แสดงจำนวนที่สมัครไปแล้ว)
  description  String? // ลักษณะงาน
  sortOrder    Int               @default(0)
  applications CoopApplication[]

  @@index([postingId])
}

// อาจารย์ที่ปรึกษา / อาจารย์รายวิชา / อาจารย์นิเทศก์ / เจ้าหน้าที่ (Staff)
model Staff {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  user               User      @relation(fields: [userId], references: [id])
  name               String
  department         String?   // สาขาวิชา เช่น "วิศวกรรมซอฟต์แวร์", "ธุรกิจดิจิทัล"

  // Multi-role flags สำหรับอาจารย์ / บุคลากร
  isCourseAdmin      Boolean   @default(false) // อาจารย์ประจำวิชา / ประธานหลักสูตร
  isAdvisor          Boolean   @default(false) // อาจารย์ที่ปรึกษา
  isSupervisor       Boolean   @default(false) // อาจารย์นิเทศก์
  isStaff            Boolean   @default(false) // เจ้าหน้าที่คณะ (เช่น พี่จอม) - ถ้าเป็น true จะเป็นเจ้าหน้าที่ฝ่ายฝึกงาน

  studentsAdvised    Student[] @relation("AdvisorToStudents")
  studentsSupervised Student[] @relation("SupervisorToStudents")
}

// =====================================================================
// 3. APPROVAL STATUS (ใช้ร่วมกันกับ CV / Training record / Company checklist)
//    ผ่าน / ไม่ผ่าน / รออนุมัติ  + หมายเหตุ เหตุผล
// =====================================================================

enum ApprovalStatus {
  PENDING   // รออนุมัติ
  APPROVED  // ผ่าน
  REJECTED  // ไม่ผ่าน
}

// =====================================================================
// 4. CV
// =====================================================================

model StudentCV {
  id         Int            @id @default(autoincrement())
  studentId  Int            @unique
  student    Student        @relation(fields: [studentId], references: [id])

  fileUrl    String
  fileName   String?

  status     ApprovalStatus @default(PENDING)
  note       String?        // หมายเหตุ กรณีไม่ผ่าน

  reviewedById Int?
  reviewedAt   DateTime?

  uploadedAt DateTime       @default(now())
}

// =====================================================================
// 5. SOFT / HARD SKILL TRAINING RECORD (ใบ certificate การอบรม)
// =====================================================================

enum SkillType {
  SOFT
  HARD
}

model TrainingRecord {
  id                Int            @id @default(autoincrement())
  studentId         Int
  student           Student        @relation(fields: [studentId], references: [id])

  title             String         // ชื่อกิจกรรมอบรม/Certificate เช่น "อบรม Java dev"
  skillType         SkillType
  hours             Int            // จำนวนชั่วโมง
  certificateFileUrl String?
  certificateLink   String?        // ลิงก์อ้างอิงของ Certificate (หน้าผู้จัด/ประชาสัมพันธ์/ตรวจสอบใบรับรอง) — กันการปลอมแปลงไฟล์
  academicYear      String?        // ปีการศึกษา เช่น "2567"
  source            String?        @default("STUDENT_UPLOAD") // แหล่งที่มา: "STUDENT_UPLOAD" (นิสิตยื่นเอง), "STAFF_IMPORT" (พี่จอมนำเข้า), "ADMIN_IMPORT" (อาจารย์ประจำวิชาเพิ่มให้/นำเข้า)

  status            ApprovalStatus @default(PENDING) // อนุมัติใน Cert. (ผ่าน/ไม่ผ่าน)
  note              String?

  reviewedById      Int?
  reviewedAt        DateTime?

  createdAt         DateTime       @default(now())
}

// =====================================================================
// 6. COMPANY CHECKLIST (นิสิตกรอก checklist 5 ส่วน ต่อ 1 บริษัทที่สนใจยื่น)
// =====================================================================

enum ChecklistVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ChecklistVersion {
  id          Int                    @id @default(autoincrement())
  versionName String                 // เช่น "v1.0 (ปีการศึกษา 2567)", "v2.0 (ปีการศึกษา 2568)"
  description String?
  status      ChecklistVersionStatus @default(DRAFT)
  majorCodes  String[]               @default([]) // สาขาที่ใช้แบบฟอร์มนี้ (รหัสใน src/utils/majors.ts) — ว่าง = แบบฟอร์มกลาง (สาขาที่ไม่มีแบบฟอร์มเฉพาะ)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  sections    ChecklistSection[]
  companies   Company[]
}

model ChecklistSection {
  id          Int               @id @default(autoincrement())
  versionId   Int?              // ผูกกับ version (optional เพื่อ backward compatibility)
  version     ChecklistVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  title       String            // เช่น "ส่วนที่ 1 ความน่าเชื่อถือของบริษัท"
  order       Int               // ลำดับหมวด

  items       ChecklistItem[]

  @@unique([versionId, order])
}

model ChecklistItem {
  id          Int                      @id @default(autoincrement())
  sectionId   Int
  section     ChecklistSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order       Int                      // ลำดับข้อภายในหมวด (1, 2, 3, ...)
  description String                   // เช่น "1. Google Maps: ปักหมุดแล้วจอสถานที่จริงไหม?"
  placeholder String?                  // คำแนะนำ/ตัวอย่างคำตอบ เช่น "เช่น ระบุทุนจดทะเบียน หรือสถานะ Active"
  isRequired  Boolean                  @default(false) // ข้อบังคับหรือไม่
  isActive    Boolean                  @default(true)  // เปิด/ปิดใช้งาน

  answers     CompanyChecklistAnswer[]

  @@unique([sectionId, order])
}

// บริษัทที่นิสิตสนใจยื่น (1 นิสิต เพิ่มได้หลายบริษัท) พร้อมสถานะที่อาจารย์ตัดสิน
model Company {
  id                 Int               @id @default(autoincrement())
  studentId          Int
  student            Student           @relation(fields: [studentId], references: [id])

  name               String            // เช่น "บริษัท Magus software"

  checklistVersionId Int?
  checklistVersion   ChecklistVersion? @relation(fields: [checklistVersionId], references: [id])

  checklistStatus    ApprovalStatus    @default(PENDING) // ผ่าน/ไม่ผ่าน/รออนุมัติ (อาจารย์ตรวจ)
  checklistNote      String?           // หมายเหตุ เช่น "ขาดข้อมูล"

  reviewedById       Int?
  reviewedAt         DateTime?

  answers            CompanyChecklistAnswer[]
  submission         CompanySubmission?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

// คำตอบ checklist แต่ละข้อ ต่อ 1 บริษัท (checkbox + รายละเอียดเพิ่ม)
model CompanyChecklistAnswer {
  id              Int           @id @default(autoincrement())
  companyId       Int
  company         Company       @relation(fields: [companyId], references: [id])
  checklistItemId Int
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id])

  checked         Boolean       @default(false)
  detail          String?       // รายละเอียดเพิ่ม

  @@unique([companyId, checklistItemId])
}

// =====================================================================
// 7. สถานะการยื่น (ปลดล็อกให้กรอกได้ก็ต่อเมื่อ Company.checklistStatus = APPROVED)
// =====================================================================

// ยืนยัน label แล้วจาก dropdown จริงใน status_all.html
enum SubmissionStatus {
  NOT_SUBMITTED             // ยังไม่ได้ยื่น
  SUBMITTED_WAITING         // ยื่นแล้ว รอสัมภาษณ์
  INTERVIEWED_PENDING       // สัมภาษณ์แล้ว รอผล
  INTERVIEW_PASSED          // สัมภาษณ์ผ่านแล้ว
  INTERVIEW_FAILED_REAPPLIED // สัมภาษณ์ไม่ผ่าน ยื่นเพิ่มแล้ว
}

model CompanySubmission {
  id        Int              @id @default(autoincrement())
  companyId Int              @unique
  company   Company          @relation(fields: [companyId], references: [id])

  status    SubmissionStatus @default(NOT_SUBMITTED)
  updatedAt DateTime         @updatedAt
}

// =====================================================================
// 8. ข้อมูลบริษัทที่เข้าฝึกงานจริง (กรอกครั้งเดียว หลังสัมภาษณ์ผ่านแล้วเลือกที่ไปฝึกจริง)
// =====================================================================

model InternshipPlacement {
  id                    Int      @id @default(autoincrement())
  studentId             Int      @unique
  student               Student  @relation(fields: [studentId], references: [id])

  companyId             Int?     // ลิงก์กลับไปยังบริษัทใน checklist ที่เลือก (ถ้ามี)

  position              String?  // ตำแหน่งที่ฝึก
  companyNameTh         String?  // ชื่อแหล่งฝึกงาน (ภาษาไทย)
  contactPersonName     String?  // ชื่อบุคคลที่ให้หนังสือความอนุเคราะห์
  contactPersonPosition String?  // ตำแหน่งบุคคลที่ให้หนังสือความอนุเคราะห์
  companyAddress        String?  // ที่อยู่บริษัท
  companyPhone1         String?  // เบอร์โทรติดต่อสถานประกอบการ/แหล่งฝึก
  companyPhone2         String?  // เบอร์โทรติดต่อสถานประกอบการ/แหล่งฝึก (ช่องที่ 2)
  companyEmail          String?
  province               String?
  latitude              Float?   // พิกัดที่นิสิตปักหมุดจากแผนที่ (ค้นหาสถานที่ใน Checklist)
  longitude             Float?

  status                ApprovalStatus @default(PENDING) // อนุมัติ/ไม่อนุมัติ ที่ฝึกงาน (อาจารย์รายวิชาตั้ง)
  note                  String?        // หมายเหตุจากอาจารย์ กรณีไม่อนุมัติ
  reviewedById          Int?           // ID อาจารย์ที่ตรวจ
  reviewedAt            DateTime?      // วันที่ตรวจ

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// =====================================================================
// 9. EXPRESS-SESSION STORE (connect-pg-simple)
// =====================================================================

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

// ---------------------------------------------------------------------
// สหกิจศึกษา: ใบสมัครของนิสิต (สมัครได้ทีละ 1 ตำแหน่ง · เลือกได้ทางเดียว ฝึกงาน หรือ สหกิจ)
// สถานะเปลี่ยนโดยเจ้าหน้าที่ · REJECTED = เก็บเข้าประวัติ แล้วสมัครที่อื่น/ไปฝึกงานได้
// ---------------------------------------------------------------------
enum CoopApplicationStatus {
  SUBMITTED // ส่งใบสมัครแล้ว (รอเจ้าหน้าที่พิจารณา)
  SENT_TO_COMPANY // คณะส่งเอกสารให้บริษัทแล้ว
  ACCEPTED // ผ่านการคัดเลือก
  REJECTED // ไม่ผ่าน (เก็บเข้าประวัติ)
  CANCELLED // ยกเลิก — นิสิตยกเลิกเอง (ก่อนส่งเอกสารให้บริษัท) หรือเจ้าหน้าที่ยกเลิกให้ (เก็บเข้าประวัติ)
}

/// ขั้นเอกสารหลังผ่านการคัดเลือก (เจ้าหน้าที่เลื่อนขั้นเอง แนบ PDF ได้ไม่บังคับ)
enum CoopDocStep {
  NONE // ยังไม่เริ่ม
  REQUEST_LETTER // ออกหนังสือขอความอนุเคราะห์แล้ว
  ACCEPTANCE_FORM // ได้รับแบบตอบรับจากบริษัทแล้ว
  DISPATCH_LETTER // ออกหนังสือส่งตัวแล้ว
}

model CoopApplication {
  id              Int                   @id @default(autoincrement())
  studentId       Int
  student         Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  postingId       Int
  posting         CoopPosting           @relation(fields: [postingId], references: [id], onDelete: Restrict)
  positionId      Int
  position        CoopPosition          @relation(fields: [positionId], references: [id], onDelete: Restrict)
  windowId        Int? // รอบออกฝึกที่ผูกตอนสมัคร (เหมือนการเลือกสถานประกอบการ)
  window          InternshipWindow?     @relation(fields: [windowId], references: [id], onDelete: SetNull)
  companyName     String // ชื่อบริษัท ณ วันที่สมัคร (กันประกาศถูกแก้ภายหลัง)
  positionTitle   String // ชื่อตำแหน่ง ณ วันที่สมัคร
  resumeUrl       String
  resumeName      String?
  transcriptUrl   String
  transcriptName  String?
  portfolioUrl    String? // ไฟล์ Portfolio (ไม่บังคับ)
  portfolioName   String?
  portfolioLink   String? // หรือ ลิงก์ Portfolio
  status          CoopApplicationStatus @default(SUBMITTED)
  statusNote      String? // เหตุผล (เช่น กรณีไม่ผ่าน)
  statusUpdatedAt DateTime?
  statusUpdatedBy String?

  // ขั้นเอกสารหลังผ่านการคัดเลือก (ใช้เมื่อ status = ACCEPTED)
  docStep            CoopDocStep @default(NONE)
  docStepUpdatedBy   String?
  requestLetterAt    DateTime?
  requestLetterUrl   String? // PDF แนบ (ไม่บังคับ)
  requestLetterName  String?
  acceptanceFormAt   DateTime?
  acceptanceFormUrl  String?
  acceptanceFormName String?
  dispatchLetterAt   DateTime?
  dispatchLetterUrl  String?
  dispatchLetterName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([postingId])
  @@index([status])
}
